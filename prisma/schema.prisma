datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Firm {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  leadAdvocate       String?
  contactPhone       String?
  clientMessageIntro String?
  clientCustomNote   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cases              Case[]
}

model Lawyer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases     Case[]
}

model Client {
  id             String   @id @default(uuid())
  name           String
  whatsappNumber String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cases          Case[]
}

model Case {
  id                String         @id @default(uuid())
  cnr               String         @unique
  lawyerId          String
  clientId          String
  firmId            String?
  courtName         String
  caseNumber        String
  filingYear        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lastCheckedAt     DateTime?
  lastModifiedAt    DateTime?
  monitoringEnabled Boolean        @default(true)

  lawyer            Lawyer         @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm              Firm?          @relation(fields: [firmId], references: [id], onDelete: SetNull)
  snapshots         CaseSnapshot[]
  events            CaseEvent[]

  @@index([cnr])
  @@index([lawyerId])
  @@index([clientId])
  @@index([firmId])
}

model CaseSnapshot {
  id              String   @id @default(uuid())
  caseId          String
  snapshotHash    String
  rawData         Json
  importantFields Json
  createdAt       DateTime @default(now())

  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseEvent {
  id                 String         @id @default(uuid())
  caseId             String
  eventType          String
  eventKey           String?        // Deterministic update key (e.g. CNR:NEXT_HEARING:2026-11-15)
  description        String
  previousData       Json?
  newData            Json?
  detectedAt         DateTime       @default(now())
  notificationStatus String         @default("PENDING") // PENDING, SENT, FAILED, SKIPPED, DUPLICATE_SKIPPED

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([caseId])
  @@index([eventKey])
}

model Notification {
  id                String    @id @default(uuid())
  caseEventId       String
  recipientType     String    // LAWYER, CLIENT
  recipientName     String?   // Name of lawyer or client
  recipientPhone    String
  messageBody       String?   @db.Text // Full logged text of the message sent
  channel           String    @default("WHATSAPP")
  status            String    @default("PENDING") // PENDING, SENT, FAILED, MOCKED, DUPLICATE_SKIPPED
  idempotencyKey    String?   // caseId:recipientPhone:eventType:value
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  caseEvent         CaseEvent @relation(fields: [caseEventId], references: [id], onDelete: Cascade)

  @@index([caseEventId])
  @@index([recipientPhone])
  @@index([idempotencyKey])
}
