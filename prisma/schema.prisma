datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Firm {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  leadAdvocate       String?
  contactPhone       String?
  clientMessageIntro String?
  clientCustomNote   String?
  dispatchMode       String   @default("AUTOMATIC") // "AUTOMATIC" | "MANUAL"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cases              Case[]
  members            FirmMember[]
  attendances        AttendanceRecord[]
}

model FirmMember {
  id        String   @id @default(uuid())
  firmId    String
  name      String
  phone     String
  role      String   @default("JUNIOR") // "ADMIN" (Lead/Senior Lawyer) | "JUNIOR" (Junior Advocate)
  title     String?  // e.g. "Lead Advocate", "Junior Advocate", "Associate"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm        Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]

  @@index([firmId])
  @@index([phone])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  firmId    String
  memberId  String
  date      String   // "YYYY-MM-DD" e.g. "2026-10-06"
  status    String   @default("PRESENT") // "PRESENT", "ABSENT", "ON_LEAVE", "IN_COURT"
  notes     String?  // e.g. "Appeared before Kalyan Civil Court No. 2"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member    FirmMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([firmId, memberId, date])
  @@index([firmId, date])
}

model Lawyer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases     Case[]
}

model Client {
  id             String   @id @default(uuid())
  name           String
  whatsappNumber String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cases          Case[]
}

model Case {
  id                String         @id @default(uuid())
  cnr               String
  lawyerId          String
  clientId          String
  firmId            String?
  courtName         String
  caseNumber        String
  filingYear        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lastCheckedAt     DateTime?
  lastModifiedAt    DateTime?
  monitoringEnabled Boolean        @default(true)

  lawyer            Lawyer         @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm              Firm?          @relation(fields: [firmId], references: [id], onDelete: SetNull)
  contacts          CaseContact[]
  snapshots         CaseSnapshot[]
  events            CaseEvent[]

  @@unique([cnr, firmId])
  @@index([cnr])
  @@index([lawyerId])
  @@index([clientId])
  @@index([firmId])
}

model CaseSnapshot {
  id              String   @id @default(uuid())
  caseId          String
  snapshotHash    String
  rawData         Json
  importantFields Json
  createdAt       DateTime @default(now())

  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseEvent {
  id                 String         @id @default(uuid())
  caseId             String
  eventType          String
  eventKey           String?        // Deterministic update key (e.g. CNR:NEXT_HEARING:2026-11-15)
  description        String
  previousData       Json?
  newData            Json?
  detectedAt         DateTime       @default(now())
  notificationStatus String         @default("PENDING") // PENDING, SENT, FAILED, SKIPPED, DUPLICATE_SKIPPED

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([caseId])
  @@index([eventKey])
}

model Notification {
  id                String    @id @default(uuid())
  caseEventId       String
  recipientType     String    // LAWYER, CLIENT
  recipientName     String?   // Name of lawyer or client
  recipientPhone    String
  messageBody       String?   @db.Text // Full logged text of the message sent
  channel           String    @default("WHATSAPP")
  status            String    @default("PENDING") // PENDING, SENT, FAILED, MOCKED, DUPLICATE_SKIPPED
  idempotencyKey    String?   // caseId:recipientPhone:eventType:value
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  caseEvent         CaseEvent @relation(fields: [caseEventId], references: [id], onDelete: Cascade)

  @@index([caseEventId])
  @@index([recipientPhone])
  @@index([idempotencyKey])
}

model CaseContact {
  id        String   @id @default(uuid())
  caseId    String
  type      String   // "LAWYER" | "CLIENT"
  name      String
  phone     String   // WhatsApp number
  role      String?  // e.g. "Junior Counsel", "Briefing Counsel", "Clerk", "Co-Petitioner", "Family Member"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([phone])
}
